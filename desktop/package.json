{
  "name": "apex-desktop",
  "productName": "APEX",
  "version": "1.0.0",
  "description": "APEX desktop app",
  "author": "Prototype Neo Industries",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.horizonatlas.apex",
    "productName": "APEX",
    "files": ["main.js", "package.json", "icon.png"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "APEX-Setup-${version}.exe"
    },
    "portable": { "artifactName": "APEX-Portable-${version}.exe" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": { "artifactName": "APEX-${version}-mac.dmg" }
  }
}
