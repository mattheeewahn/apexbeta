# Apex 로컬 개발용 환경변수
# 주의: 이 파일에는 비밀 값이 들어있으니 절대 git에 커밋하지 마세요 (.gitignore에 포함됨).
# 배포 전에는 아래 GOOGLE_CLIENT_SECRET을 새로 발급받은 값으로 교체하세요.

GOOGLE_CLIENT_ID=757848497981-tl0tmuu13577lb8g5d29038qjs470l5d.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# 서버를 재시작해도 로그인 세션이 유지되도록 고정 SECRET_KEY 사용
SECRET_KEY=dev-test-secret-key-change-before-deploy-1234567890

# 로컬(http)에서 Google OAuth 테스트를 허용 (배포 HTTPS 환경에서는 제거)
OAUTHLIB_INSECURE_TRANSPORT=1
APP_ENV=development
REQUIRE_EMAIL_VERIFICATION=false